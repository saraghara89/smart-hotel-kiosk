NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Set real database credentials only in the hosting provider, never in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=10

# Tenant served by this deployment.
HOTEL_SLUG=smart-stay-hotel
SESSION_TTL_HOURS=8

HOTEL_NAME=Smart Stay Hotel
HOTEL_CITY=Tel Aviv
HOTEL_LAT=32.0853
HOTEL_LON=34.7818
