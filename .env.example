NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# PostgreSQL connection string. Set the real secret only in the hosting provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true

# Generate long random secrets. Never commit real values.
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ISSUER=smart-stay-api
TOKEN_AUDIENCE=smart-stay-admin
ACCESS_TOKEN_TTL_MINUTES=15

HOTEL_NAME=Smart Stay Hotel
HOTEL_CITY=Tel Aviv
HOTEL_LAT=32.0853
HOTEL_LON=34.7818
